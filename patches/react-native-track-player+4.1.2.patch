+    private fun applyClassicNotificationStyle() {
+        if (!classicNotification || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        try {
+            val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+            if (nm.getNotificationChannel(CLASSIC_CHANNEL_ID) == null) {
+                nm.createNotificationChannel(
+                    NotificationChannel(CLASSIC_CHANNEL_ID, CLASSIC_CHANNEL_NAME, NotificationManager.IMPORTANCE_DEFAULT).apply {
+                        setSound(null, null)
+                        enableVibration(false)
+                        enableLights(false)
+                        setShowBadge(false)
+                        lockscreenVisibility = Notification.VISIBILITY_PUBLIC
+                    }
+                )
+            }
+            val holder = player.notificationManager
+            val internalField = holder.javaClass.getDeclaredField("internalNotificationManager").apply { isAccessible = true }
+            val pnm = internalField.get(holder) as? com.google.android.exoplayer2.ui.PlayerNotificationManager ?: return
+            val cls = com.google.android.exoplayer2.ui.PlayerNotificationManager::class.java
+            cls.getDeclaredField("channelId").apply { isAccessible = true }.set(pnm, CLASSIC_CHANNEL_ID)
+            cls.getDeclaredField("mediaSessionToken").apply { isAccessible = true }.set(pnm, null)
+            // KotlinAudio 는 STOP 버튼을 ExoPlayer 기본 Stop + 자체 custom "stop" 두 개로 넣는다 → 기본 것을 끈다
+            // (custom 쪽이 RemoteStop 이벤트를 낸다). setUseStopAction 이 invalidate 를 부른다.
+            pnm.setUseStopAction(false)
+            pnm.invalidate()
+        } catch (e: Throwable) {
+            Timber.w(e, "classic notification style failed")
+        }
+    }
+
+    private fun needsClassicRestyle(notification: Notification): Boolean {
+        if (!classicNotification || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return false
+        if (notification.channelId != CLASSIC_CHANNEL_ID ||
+            notification.extras?.containsKey(Notification.EXTRA_MEDIA_SESSION) == true) return true
+        // KotlinAudio 가 버튼 설정을 나중에 다시 적용하면 기본 Stop 이 되살아난다
+        return try {
+            val holder = player.notificationManager
+            val pnm = holder.javaClass.getDeclaredField("internalNotificationManager").apply { isAccessible = true }.get(holder)
+                ?: return false
+            com.google.android.exoplayer2.ui.PlayerNotificationManager::class.java
+                .getDeclaredField("useStopAction").apply { isAccessible = true }.getBoolean(pnm)
+        } catch (e: Throwable) {
+            false
+        }
+    }
